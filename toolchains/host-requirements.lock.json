        ],
        "required_by_platform": {
          "win32": [
            "devkitsnes/snes_rules",
            "devkitsnes/bin/816-tcc.exe",
            "devkitsnes/bin/wla-65816.exe",
            "pvsneslib/include/snes/libversion.h",
            "pvsneslib/lib/LoROM_SlowROM/libc.obj"
          ]
        }
      },
      "install_by_platform": {
        "linux": {
          "kind": "source_build",
          "minimum_free_bytes": 2147483648,
          "artifacts": [
            "pvsneslib-source"
          ],
          "overlays": [
            {
              "artifact": "pvsneslib-tcc-source",
              "target": "compiler/tcc"
            },
            {
              "artifact": "pvsneslib-wla-source",
              "target": "compiler/wla-dx"
            }
          ],
          "env": {
            "PVSNESLIB_HOME": "${source}"
          },
          "steps": [
            {
              "label": "compiler",
              "program": "make",
              "args": [
                "-j${jobs}",
                "-C",
                "compiler"
              ],
              "cwd": "${source}"
            },
            {
              "label": "tools",
              "program": "make",
              "args": [
                "-j${jobs}",
                "-C",
                "tools"
              ],
              "cwd": "${source}"
            },
            {
              "label": "install-compiler",
              "program": "make",
              "args": [
                "-C",
                "compiler",
                "install"
              ],
              "cwd": "${source}"
            },
            {
              "label": "install-tools",
              "program": "make",
              "args": [
                "-C",
                "tools",
                "install"
              ],
              "cwd": "${source}"
            },
            {
              "label": "libraries",
              "program": "make",
              "args": [
                "-j${jobs}",
                "-C",
                "pvsneslib"
              ],
              "cwd": "${source}"
            }
          ],
          "target": "${hostCache}/toolchains/pvsneslib"
