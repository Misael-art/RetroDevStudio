        ],
        "candidates": [
          "${hostCache}/toolchains/pvsneslib",
          "${repo}/toolchains/pvsneslib"
        ],
        "required": [
          "devkitsnes/snes_rules",
          "devkitsnes/bin/816-tcc",
          "devkitsnes/bin/wla-65816",
          "pvsneslib/include/snes/libversion.h",
