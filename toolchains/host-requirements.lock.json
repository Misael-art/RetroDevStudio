    {
      "id": "m68k_gcc",
      "label": "m68k-elf-gcc 13.2.0",
      "platforms": [
        "linux"
      ],
      "probe": {
        "kind": "command",
        "names": [
          "m68k-elf-gcc"
        ],
        "candidates": [
          "${hostCache}/toolchains/m68k-elf/bin/m68k-elf-gcc"
        ],
        "version_args": [
          "--version"
        ],
        "version_pattern": "13\\.2\\.0"
      },
      "install_by_platform": {
        "linux": {
          "kind": "source_build",
          "minimum_free_bytes": 12884901888,
          "artifacts": [
            "binutils-2.41-source"
          ],
          "overlays": [
            {
              "artifact": "gcc-13.2.0-source",
              "target": "gcc-source"
            }
          ],
          "path_prepend": [
            "${source}/install/bin",
            "/usr/bin/core_perl"
          ],
          "env": {
            "CXXFLAGS": "-O2 -std=gnu++11"
          },
          "steps": [
            {
              "label": "prepare-build-dirs",
              "program": "mkdir",
              "args": [
                "-p",
                "${source}/build-binutils",
                "${source}/build-gcc"
              ]
            },
            {
              "label": "configure-binutils",
              "program": "${source}/configure",
              "args": [
                "--target=m68k-elf",
                "--prefix=${source}/install",
                "--disable-nls",
                "--disable-werror"
              ],
              "cwd": "${source}/build-binutils"
            },
            {
              "label": "build-binutils",
              "program": "make",
              "args": [
                "-j${jobs}",
                "all-binutils",
                "all-gas",
                "all-ld"
              ],
              "cwd": "${source}/build-binutils"
            },
            {
              "label": "install-binutils",
              "program": "make",
              "args": [
                "install-binutils",
                "install-gas",
                "install-ld"
              ],
              "cwd": "${source}/build-binutils"
            },
            {
              "label": "configure-gcc",
              "program": "${source}/gcc-source/configure",
              "args": [
                "--target=m68k-elf",
                "--prefix=${source}/install",
                "--enable-languages=c",
                "--without-headers",
                "--disable-nls",
                "--disable-bootstrap",
                "--disable-analyzer",
                "--enable-lto",
                "--disable-shared",
                "--disable-threads",
                "--disable-libssp",
                "--disable-libquadmath",
                "--disable-libgomp",
                "--disable-libatomic"
              ],
              "cwd": "${source}/build-gcc"
            },
            {
              "label": "build-gcc",
              "program": "make",
              "args": [
                "-j${jobs}",
                "all-gcc",
                "all-target-libgcc"
              ],
              "cwd": "${source}/build-gcc"
            },
            {
              "label": "install-gcc",
              "program": "make",
              "args": [
                "install-gcc",
                "install-target-libgcc"
              ],
              "cwd": "${source}/build-gcc"
            }
          ],
          "output": "install",
          "target": "${hostCache}/toolchains/m68k-elf"
        }
      }
    },
    {
      "id": "sgdk",
      "label": "SGDK 2.11",
      "probe": {
        "kind": "path",
        "env_candidates": [
          "SGDK_ROOT",
          "GDK"
        ],
        "candidates": [
          "${hostCache}/toolchains/sgdk",
          "${repo}/toolchains/sgdk"
        ],
        "required": [
          "makefile.gen",
          "inc/genesis.h"
        ],
        "required_by_platform": {
          "linux": [
            "makefile.gen",
            "inc/genesis.h",
            "lib/libmd.a",
            "bin/bintos",
            "bin/sjasm",
            "bin/convsym"
          ],
          "win32": [
            "makefile.gen",
            "inc/genesis.h",
            "lib/libmd.a",
            "bin/gcc.exe"
          ]
        }
      },
      "install_by_platform": {
        "linux": {
          "kind": "source_build",
          "minimum_free_bytes": 2147483648,
          "artifacts": [
            "sgdk-source"
          ],
          "path_prepend": [
            "${hostCache}/toolchains/m68k-elf/bin"
          ],
          "env": {
            "PREFIX": "m68k-elf-"
          },
          "steps": [
            {
              "label": "configure",
              "program": "cmake",
              "args": [
                "-S",
                "${source}",
                "-B",
                "${source}/build",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
              ]
            },
            {
              "label": "build-libraries-and-tools",
              "program": "cmake",
              "args": [
                "--build",
                "${source}/build",
                "--parallel",
                "${jobs}"
              ]
            },
            {
              "label": "build-convsym",
              "program": "make",
              "args": [
                "-j${jobs}"
              ],
              "cwd": "${source}/tools/convsym"
            },
            {
              "label": "install-convsym",
              "program": "cp",
              "args": [
                "${source}/tools/convsym/build/convsym",
                "${source}/bin/convsym"
              ]
            }
          ],
          "target": "${hostCache}/toolchains/sgdk"
        },
        "win32": {
          "kind": "artifact",
          "artifact": "sgdk-win32-x64",
          "target": "${hostCache}/toolchains/sgdk",
          "executables": [
            "bin/gcc.exe",
            "bin/make.exe",
            "bin/sh.exe"
          ]
        }
      }
    },
    {
